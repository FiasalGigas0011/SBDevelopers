@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background-color: #121212;
    }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #121212;
    }

    .login-box {
        max-width: 400px;
        width: 100%;
        padding: 30px 25px;
        background-color: #1e1e1e;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.4);
        text-align: center;
    }

    .welcome-text {
        color: #f5f5f5;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 10px;
        letter-spacing: 0.5px;
    }

        .welcome-text span {
            color: #c49a6c; /* Gold tone */
        }

    .login-logo img {
        max-width: 280px;
        height: auto;
        margin-bottom: 25px;
        background-color: #000;
        padding: 12px;
        border-radius: 10px;
    }

    .login-box input[type="text"],
    .login-box input[type="password"] {
        height: 48px;
        margin-bottom: 18px;
        border-radius: 6px;
        border: 1px solid #555;
        padding: 0 15px;
        font-size: 1rem;
        font-weight: 500;
        background: #2a2a2a;
        color: #fff;
        transition: border 0.3s, box-shadow 0.3s;
    }

    .login-box input::placeholder {
        color: #aaa;
    }

    .login-box input:focus {
        border-color: #c49a6c;
        box-shadow: 0 0 10px rgba(196, 154, 108, 0.5);
        outline: none;
    }

    .login-box button {
        width: 100%;
        padding: 12px 0;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 6px;
        background: linear-gradient(to right, #c49a6c, #b07d45);
        color: white;
        border: none;
        cursor: pointer;
        transition: opacity 0.3s ease;
        letter-spacing: 0.5px;
    }

        .login-box button:hover {
            opacity: 0.9;
        }

    .error-message {
        margin-top: 12px;
        color: #ff4c4c;
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>

<div class="login-wrapper">
    <div class="login-box">

        <div class="welcome-text">Welcome to <span>SK Developers</span></div>


        <div class="login-logo">
            <img src="~/images/SKdevelopers.png" alt="SK Developers Logo" />
        </div>


        <form method="post" autocomplete="off">
            <input type="text" name="username" placeholder="Username" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Login</button>
        </form>


        @if (ViewBag.Error != null)
        {
            <p class="error-message">@ViewBag.Error</p>
        }
    </div>
</div>
