@model RealEstatePay.Models.PaymentModel
@{
    ViewBag.Title = "Dashboard";
}



<div class="dashboard-container">
    <div class="logout-container">
        <a href="@Url.Action("Contacts", "PaymentSms")" class="three-dots-btn">⋯</a>
        <form method="post" asp-controller="PaymentSms" asp-action="Logout">
            <button type="submit">Logout</button>
        </form>
    </div>

    <img src="~/images/SKdevelopers.png" alt="SK Developers Logo" />
    <h2>Enter Payment Details</h2>

   <form id="paymentForm">
    <input type="text" id="CustomerName" name="CustomerName" placeholder="Customer Name" />
    <input type="text" id="PlotNumber" name="PlotNumber" placeholder="Plot Number (Optional)" />
    <select id="SiteOrLayoutName" name="SiteOrLayoutName" required>
        <option value="">-- Select Site/Layout Name --</option>
            <option value="Godhani">Godhani</option>
            <option value="lonara">lonara</option>
            <option value="Bailwada">Bailwada</option>
            <option value="Bokhara and chakkikhapa">Bokhara and chakkikhapa</option>
            <option value="Bhartwada">Bhartwada</option>
    </select>
    <input type="text" id="LayoutNumber" name="LayoutNumber" placeholder="Layout Number (Optional)" />
    <input type="text" id="ContactNumber" name="ContactNumber" placeholder="Contact Number" required />
    <input type="text" id="Message" name="Message" placeholder="Message (Optional)" />
    <input type="number" id="AmountPaid" name="AmountPaid" placeholder="Amount Paid" required />
    <button type="button" onclick="showConfirmModal()">Process</button>
</form>


    @if (ViewBag.Message != null)
    {
        <p class="message success">@ViewBag.Message</p>
    }

    @if (ViewBag.Error != null)
    {
        <p class="message error">@ViewBag.Error</p>
    }
</div>

<div id="confirmModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Confirm Payment Details</h3>
            <span class="close" onclick="closeModal()">&times;</span>
        </div>
        <div id="modalDetails"></div>
        <div class="modal-buttons">
            <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button type="button" class="btn-send" onclick="sendSMS()">Send</button>
        </div>
    </div>
</div>

<script>
    window.dashboardUrl = '@Url.Action("Dashboard", "PaymentSms")';
</script>
