@model RealEstatePay.Models.PaymentModel
@{
    ViewBag.Title = "Dashboard";
}

<style>
    .dashboard-container {
        max-width: 500px;
        margin: 40px auto;
        padding: 30px 25px;
        background: #1e1e1e;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        color: white;
    }

        .dashboard-container h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: 700;
            color: #c49a6c;
        }

        .dashboard-container img {
            max-width: 180px;
            display: block;
            margin: 0 auto 20px;
        }

    form input {
        width: 100%;
        padding: 12px 15px;
        margin-bottom: 18px;
        font-size: 1rem;
        border: 1px solid #444;
        border-radius: 6px;
        background: #2a2a2a;
        color: white;
    }

        form input:focus {
            border-color: #c49a6c;
            outline: none;
            box-shadow: 0 0 8px rgba(196, 154, 108, 0.5);
        }

    form button {
        width: 100%;
        padding: 14px 0;
        font-size: 1.1rem;
        background: linear-gradient(to right, #c49a6c, #b07d45);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        form button:hover {
            opacity: 0.9;
        }

    .message {
        margin-top: 15px;
        font-weight: 600;
        text-align: center;
    }

        .message.success {
            color: #28a745;
        }

        .message.error {
            color: #ff4c4c;
        }

    .logout-container {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

        .logout-container form button {
            background-color: #dc3545;
            width: auto;
            padding: 8px 18px;
            font-size: 1rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            color: white;
        }

            .logout-container form button:hover {
                background-color: #a71d2a;
            }

    .three-dots-btn {
        background-color: #c49a6c;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 1.2rem;
        display: inline-block;
    }

        .three-dots-btn:hover {
            background-color: #b07d45;
            color: white;
        }

    form select {
        width: 100%;
        padding: 12px 15px;
        margin-bottom: 18px;
        font-size: 1rem;
        border: 1px solid #444;
        border-radius: 6px;
        background: #2a2a2a;
        color: white;
        appearance: none; /* Removes default arrow styling */
    }

        form select:focus {
            border-color: #c49a6c;
            outline: none;
            box-shadow: 0 0 8px rgba(196, 154, 108, 0.5);
        }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
        background-color: #1e1e1e;
        margin: 15% auto;
        padding: 20px;
        border-radius: 10px;
        width: 80%;
        max-width: 500px;
        color: white;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-header h3 {
        color: #c49a6c;
        margin: 0;
    }

    .close {
        color: #aaa;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover {
        color: white;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #444;
    }

    .detail-label {
        font-weight: 600;
        color: #c49a6c;
    }

    .modal-buttons {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-buttons button {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-cancel {
        background-color: #6c757d;
        color: white;
    }

    .btn-send {
        background: linear-gradient(to right, #c49a6c, #b07d45);
        color: white;
    }

</style>

<div class="dashboard-container">
    <div class="logout-container">
        <a href="@Url.Action("Contacts", "PaymentSms")" class="three-dots-btn">⋯</a>
        <form method="post" asp-controller="PaymentSms" asp-action="Logout">
            <button type="submit">Logout</button>
        </form>
    </div>

    <img src="~/images/SKdevelopers.png" alt="SK Developers Logo" />
    <h2>Enter Payment Details</h2>

   <form id="paymentForm">
    <input type="text" id="CustomerName" name="CustomerName" placeholder="Customer Name" />
    <input type="text" id="PlotNumber" name="PlotNumber" placeholder="Plot Number (Optional)" />
    <select id="SiteOrLayoutName" name="SiteOrLayoutName" required>
        <option value="">-- Select Site/Layout Name --</option>
            <option value="Godhani">Godhani</option>
            <option value="lonara">lonara</option>
            <option value="Bailwada">Bailwada</option>
            <option value="Bokhara and chakkikhapa">Bokhara and chakkikhapa</option>
            <option value="Bhartwada">Bhartwada</option>
    </select>
    <input type="text" id="LayoutNumber" name="LayoutNumber" placeholder="Layout Number (Optional)" />
    <input type="text" id="ContactNumber" name="ContactNumber" placeholder="Contact Number" required />
    <input type="text" id="Message" name="Message" placeholder="Message (Optional)" />
    <input type="number" id="AmountPaid" name="AmountPaid" placeholder="Amount Paid" required />
    <button type="button" onclick="showConfirmModal()">Process</button>
</form>


    @if (ViewBag.Message != null)
    {
        <p class="message success">@ViewBag.Message</p>
    }

    @if (ViewBag.Error != null)
    {
        <p class="message error">@ViewBag.Error</p>
    }
</div>

<div id="confirmModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Confirm Payment Details</h3>
            <span class="close" onclick="closeModal()">&times;</span>
        </div>
        <div id="modalDetails"></div>
        <div class="modal-buttons">
            <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button type="button" class="btn-send" onclick="sendSMS()">Send</button>
        </div>
    </div>
</div>

<script>
function showConfirmModal() {
    const form = document.getElementById('paymentForm');
    const formData = new FormData(form);
    
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }
    
    let details = '';
    details += `<div class="detail-row"><span class="detail-label">Customer Name:</span><span>${formData.get('CustomerName') || 'N/A'}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Plot Number:</span><span>${formData.get('PlotNumber') || 'N/A'}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Site/Layout:</span><span>${formData.get('SiteOrLayoutName')}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Layout Number:</span><span>${formData.get('LayoutNumber') || 'N/A'}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Contact Number:</span><span>${formData.get('ContactNumber')}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Message:</span><span>${formData.get('Message') || 'N/A'}</span></div>`;
    details += `<div class="detail-row"><span class="detail-label">Amount Paid:</span><span>₹${formData.get('AmountPaid')}</span></div>`;
    
    document.getElementById('modalDetails').innerHTML = details;
    document.getElementById('confirmModal').style.display = 'block';
}

function closeModal() {
    document.getElementById('confirmModal').style.display = 'none';
}

function sendSMS() {
    const form = document.getElementById('paymentForm');
    const formData = new FormData(form);
    
    const hiddenForm = document.createElement('form');
    hiddenForm.method = 'POST';
    hiddenForm.action = '@Url.Action("Dashboard", "PaymentSms")';
    
    for (let [key, value] of formData.entries()) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = key;
        input.value = value;
        hiddenForm.appendChild(input);
    }
    
    document.body.appendChild(hiddenForm);
    hiddenForm.submit();
}

window.onclick = function(event) {
    const modal = document.getElementById('confirmModal');
    if (event.target == modal) {
        closeModal();
    }
}
</script>
