<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SB Developers - @ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/sbdevLogo.png" />

    <!-- Bootstrap and site styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEstatePay.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #121212;
            color: #f1f1f1;
            font-family: 'Segoe UI', sans-serif;
        }

        header, footer {
            background-color: #1e1e1e;
            color: #c49a6c;
        }

        .navbar {
            background-color: #1e1e1e !important;
        }

        .navbar-brand img {
            max-height: 40px;
            vertical-align: middle;
        }

        .navbar .nav-link {
            color: #d3d3d3 !important;
        }

            .navbar .nav-link:hover {
                color: #c49a6c !important;
            }

        .footer {
            padding: 15px 0;
            font-size: 0.9rem;
        }

        a {
            color: #c49a6c;
        }

            a:hover {
                color: #e5b36c;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom mb-3">
            <div class="container-fluid">
                <!-- Logo or App Name -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="PaymentSms" asp-action="Login">
                    <img src="~/images/SKdevelopers.png" alt="SK Developers Logo" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top text-center">
        <div class="container">
            &copy; 2025 all right reserve by <a href="https://cognerasystems.com" target="_blank">Cognera System</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
